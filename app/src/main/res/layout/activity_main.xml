<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundimage"
    tools:context=".MainActivity"
    android:padding="16dp"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/headingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Closet Craft"
        android:textSize="50sp"
        android:layout_marginTop="300dp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@android:color/white" />

    <TextView
        android:id="@+id/subheadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WHERE STYLE MEETS CRAFT"
        android:textSize="15sp"
        android:textStyle="italic"
        android:gravity="center"
        android:padding="1dp"
        android:layout_marginBottom="50dp"
        android:textColor="@android:color/white" />



    <TextView
        android:id="@+id/subheading2Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose your shopping preference"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="1dp"
        android:layout_marginBottom="10dp"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/womenBtn"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:text="WOMEN"
        android:backgroundTint="@color/lightCream"
        android:textColor="@color/black"
        android:layout_marginStart="-90dp">

    </Button>

    <Button
        android:id="@+id/menBtn"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:text="MEN"
        android:backgroundTint="@color/lightCream"
        android:textColor="@color/black"
        android:layout_marginTop="-48dp"
        android:layout_marginStart="90dp">
    </Button>

    <TextView
        android:id="@+id/or"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OR"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="1dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="5dp"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/loginBtn"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:text="LOG IN"
        android:backgroundTint="@color/lightCream"
        android:textColor="@color/black">
    </Button>

    <TextView
        android:id="@+id/question"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:text="New to Closet Craft?"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="-10dp"
        android:textColor="@android:color/white" />
    <Button
        android:id="@+id/signBtn"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Sign Up"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:layout_marginTop="-33.5sp"
        android:padding="1dp"
        android:background="@android:color/transparent"
        android:layout_marginStart="75dp">
    </Button>


</LinearLayout>